  {
    "name": "dsl-q29-referer-analysis",
    "operation-type": "raw-request",
    "method": "POST",
    "path": "/_search",
    "body": {
      "size": 0,
      "_source": false,
      "query": {
        "script": {
          "script": {
            "source": "doc['Referer'].size() != 0 && doc['Referer'].value.length() != 0"
          }
        }
      },
      "aggs": {
        "k": {
          "terms": {
            "script": {
              "source": "String v = doc['Referer'].value; int start = v.startsWith('https://') ? 8 : (v.startsWith('http://') ? 7 : -1); if (start < 0) return v; if (v.startsWith('www.', start)) start += 4; int slash = v.indexOf('/', start); return slash < 0 ? v : v.substring(start, slash);"
            },
            "size": 25,
            "shard_size": 10000,
            "order": [
              {
                "l": "desc"
              },
              {
                "_key": "asc"
              }
            ],
            "min_doc_count": 100001
          },
          "aggs": {
            "l": {
              "avg": {
                "script": {
                  "source": "doc['Referer'].value.length()"
                }
              }
            },
            "min(Referer)": {
              "top_hits": {
                "size": 1,
                "_source": false,
                "docvalue_fields": [
                  "Referer"
                ],
                "sort": [
                  {
                    "Referer": "asc"
                  }
                ]
              }
            }
          }
        }
      }
